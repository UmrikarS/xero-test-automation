# Copy this file to .env and fill in real values. Never commit .env itself.
#
# How to get these values (Custom Connection method -- simpler than the
# standard browser OAuth flow, and free for the Demo Company):
# 1. developer.xero.com/app/manage -> New App -> select "Custom connection".
# 2. Select scopes (accounting.transactions, accounting.contacts,
#    accounting.settings) and authorise against your Demo Company.
# 3. Configuration tab -> Generate a secret. Copy the Client ID and Client
#    Secret below. That's the entire setup -- no refresh token, no tenant ID,
#    no browser redirect step required.

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
